.skill-tree-graph {
    background-color: rgb(24, 26, 31);
}

GridBackground {
    --grid-background-color: rgb(24, 26, 31);
    --line-color: rgba(110, 120, 135, 0.18);
    --thick-line-color: rgba(135, 150, 170, 0.28);
    --spacing: 20;
    --thick-lines: 5;
}

.skill-tree-graph MiniMap {
    background-color: rgba(15, 17, 21, 0.94);
    border-left-color: rgb(75, 85, 100);
    border-right-color: rgb(75, 85, 100);
    border-top-color: rgb(75, 85, 100);
    border-bottom-color: rgb(75, 85, 100);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.skill-tree-node-toolbar {
    min-height: 24px;
    padding-left: 6px;
}

.skill-tree-node-toolbar-label {
    min-width: 72px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.skill-tree-collapse-all,
.skill-tree-expand-all {
    min-width: 92px;
}

.skill-tree-node {
    background-color: rgb(31, 34, 41);
    min-width: 320px;
    min-height: 240px;
    border-left-color: rgb(75, 160, 205);
    border-right-color: rgb(75, 160, 205);
    border-top-color: rgb(75, 160, 205);
    border-bottom-color: rgb(75, 160, 205);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.skill-tree-node #main,
.skill-tree-node #contents,
.skill-tree-node #extension {
    background-color: rgb(31, 34, 41);
    min-width: 0;
    flex-grow: 1;
    overflow: hidden;
}

.skill-tree-node #title {
    height: 38px;
    min-height: 38px;
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
    display: flex;
    visibility: visible;
    opacity: 1;
}

.skill-tree-node #title-label {
    display: none;
}

.skill-node-port-row {
    width: 100%;
    height: 32px;
    min-height: 32px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    margin-top: 3px;
    margin-bottom: 3px;
}

.skill-node-port-group {
    width: 150px;
    height: 32px;
    min-width: 0;
    max-width: 150px;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: visible;
}

.skill-node-input-group {
    background-color: rgb(24, 67, 88);
    width: auto;
    max-width: none;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: flex-start;
    border-left-color: rgb(64, 180, 255);
    border-left-width: 2px;
}

.skill-node-output-group {
    background-color: rgb(91, 56, 27);
    width: 120px;
    max-width: 120px;
    justify-content: flex-end;
    border-right-color: rgb(255, 148, 46);
    border-right-width: 2px;
}

.skill-tree-node #top {
    display: none;
}

.skill-node-port-group > .port {
    width: auto;
    min-width: 20px;
    flex-grow: 0;
    flex-shrink: 0;
}

.skill-node-input-port .port-label {
    color: rgb(105, 205, 255);
    -unity-font-style: bold;
}

.skill-node-input-port .connector,
.skill-node-input-port .connector-cap {
    width: 6px;
    height: 6px;
    min-width: 6px;
    min-height: 6px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: rgb(64, 184, 255);
}

.skill-node-output-port .port-label {
    color: rgb(255, 174, 82);
    -unity-font-style: bold;
}

.skill-node-output-port .connector,
.skill-node-output-port .connector-cap {
    width: 6px;
    height: 6px;
    min-width: 6px;
    min-height: 6px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: rgb(255, 148, 46);
}

.skill-tree-node Foldout,
.skill-tree-node PropertyField {
    background-color: rgb(31, 34, 41);
}

.skill-tree-node .skill-node-title-field {
    flex-grow: 0;
    flex-shrink: 0;
    height: 24px;
    margin-top: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    margin-right: 4px;
    -unity-font-style: bold;
}

.skill-node-title-field .unity-base-field__input {
    background-color: transparent;
}

.skill-node-title-field .unity-base-field__label {
    display: none;
}

.skill-tree-node #node-drag-handle {
    flex-grow: 1;
    align-self: stretch;
    -unity-text-align: middle-center;
    font-size: 22px;
    background-color: rgb(62, 67, 77);
    margin-left: 2px;
    margin-right: 3px;
}

.skill-node-output-group > .skill-node-incoming-field {
    width: 60px;
    min-width: 60px;
    max-width: 60px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    display: flex;
    visibility: visible;
}

.skill-tree-node-collapsed {
    min-width: 224px;
    width: 224px;
    min-height: 130px;
    height: 130px;
}

.skill-tree-node-collapsed .skill-node-port-row {
    height: 30px;
    min-height: 30px;
    margin-top: 0;
    margin-bottom: 0;
}

.skill-tree-node-collapsed .skill-node-port-group {
    height: 30px;
}

.skill-tree-node-collapsed .skill-node-input-group {
    width: auto;
}

.skill-tree-node-collapsed .skill-node-output-group {
    width: 120px;
}

.skill-tree-node-collapsed .skill-node-incoming-field {
    width: 60px;
    min-width: 60px;
    max-width: 60px;
}

.skill-tree-node .skill-node-incoming-field .unity-base-field__input {
    min-width: 0;
}

.skill-node-collapsed-identity {
    flex-shrink: 0;
    height: 74px;
    padding-left: 4px;
    padding-right: 4px;
    background-color: rgb(22, 24, 29);
    border-left-color: rgb(65, 70, 82);
    border-right-color: rgb(65, 70, 82);
    border-top-color: rgb(65, 70, 82);
    border-bottom-color: rgb(65, 70, 82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.skill-node-collapsed-identity .skill-node-quick-fields {
    width: auto;
    margin-left: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.skill-node-collapsed-identity .unity-base-field__label {
    width: 64px;
    min-width: 64px;
}

.skill-tree-node-collapsed #extension {
    display: none;
}

.skill-node-incoming-field .unity-base-field__label {
    display: none;
}

.skill-node-quick-row {
    height: 96px;
    min-height: 96px;
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 6px;
}

.skill-node-quick-fields {
    width: 66%;
    flex-grow: 2;
    min-width: 0;
    margin-left: 6px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 8px;
    padding-bottom: 6px;
    background-color: rgb(22, 24, 29);
    border-left-color: rgb(65, 70, 82);
    border-right-color: rgb(65, 70, 82);
    border-top-color: rgb(65, 70, 82);
    border-bottom-color: rgb(65, 70, 82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    justify-content: center;
}

.skill-node-icon-frame {
    width: 34%;
    min-width: 112px;
    height: 96px;
    flex-grow: 1;
    flex-shrink: 1;
    position: relative;
    background-color: rgb(22, 24, 29);
    border-left-color: rgb(65, 70, 82);
    border-right-color: rgb(65, 70, 82);
    border-top-color: rgb(65, 70, 82);
    border-bottom-color: rgb(65, 70, 82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    align-items: center;
    justify-content: center;
}

.skill-node-icon-preview {
    width: 88px;
    height: 88px;
    flex-shrink: 0;
}

.skill-node-icon-placeholder {
    color: rgb(125, 130, 140);
    -unity-text-align: middle-center;
}

.skill-node-icon-picker {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
}

.skill-node-icon-picker .unity-base-field__input {
    height: 100%;
    min-height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.skill-node-icon-picker .unity-object-field-display {
    opacity: 0;
}

.skill-node-icon-picker .unity-object-field-selector {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 22px;
    height: 22px;
    opacity: 1;
    background-color: rgba(42, 45, 53, 0.94);
    border-left-color: rgb(105, 112, 126);
    border-right-color: rgb(105, 112, 126);
    border-top-color: rgb(105, 112, 126);
    border-bottom-color: rgb(105, 112, 126);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.skill-node-settings-scroll {
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(31, 34, 41);
}

.skill-node-settings-scroll .unity-scroll-view__content-container {
    min-width: 0;
}

.skill-node-settings-scroll Foldout {
    margin-top: 2px;
    margin-bottom: 2px;
}

.skill-node-description TextField {
    min-height: 68px;
}

.skill-tree-node .unity-base-field {
    flex-shrink: 1;
    min-width: 0;
}

.skill-tree-node .unity-base-field__label {
    min-width: 82px;
    width: 34%;
    flex-shrink: 1;
}

.skill-tree-node .unity-base-field__input {
    min-width: 70px;
    flex-grow: 1;
}

.skill-tree-node .unity-property-field {
    min-width: 0;
    flex-shrink: 1;
}

.skill-effect-row {
    min-width: 0;
    flex-direction: column;
    margin-top: 3px;
    margin-bottom: 3px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgb(24, 26, 31);
    border-left-color: rgb(58, 63, 74);
    border-right-color: rgb(58, 63, 74);
    border-top-color: rgb(58, 63, 74);
    border-bottom-color: rgb(58, 63, 74);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.skill-effect-fields-row {
    width: 100%;
    min-width: 0;
    flex-direction: row;
    align-items: flex-end;
}

.skill-effect-row .unity-base-field__label {
    min-width: 54px;
    width: auto;
}

.skill-effect-stat {
    flex-basis: 0;
    flex-grow: 3;
    flex-shrink: 1;
}

.skill-effect-operation {
    flex-basis: 0;
    flex-grow: 2;
    flex-shrink: 1;
}

.skill-effect-value {
    width: 58%;
    flex-grow: 1;
}

.skill-effect-priority {
    width: 42%;
    flex-grow: 1;
}

.skill-custom-effect-type {
    flex-grow: 1;
}

.skill-custom-effect-property {
    width: 145px;
    flex-grow: 1;
}

.skill-effect-remove {
    width: 28px;
    min-width: 28px;
    height: 22px;
    margin-left: 4px;
    flex-shrink: 0;
}

.skill-effect-add {
    height: 24px;
    margin-top: 4px;
}

/* Equal halves in both card states, overriding compact group widths. */
.skill-tree-node .skill-node-port-row > .skill-node-port-group {
    width: 50%;
    min-width: 0;
    max-width: 50%;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
}

.skill-tree-node-collapsed .skill-node-output-group > .skill-node-incoming-field {
    width: 46px;
    min-width: 46px;
    max-width: 46px;
    margin-left: 0;
    margin-right: 0;
}

.skill-node-card-toggle {
    width: 20px;
    min-width: 20px;
    flex-shrink: 0;
    margin-left: 1px;
    margin-right: 1px;
    padding-left: 0;
    padding-right: 0;
}

.skill-tree-node #collapse-button {
    display: none;
}

.skill-tree-node .skill-level-cell .unity-base-field__label {
    min-width: 0;
    width: 48%;
    overflow: hidden;
}

.skill-tree-node .skill-level-cell .unity-base-field__input {
    min-width: 35px;
}
